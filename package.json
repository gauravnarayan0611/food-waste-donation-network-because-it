{
  "name": "food-waste-donation-network-because-it",
  "version": "1.0.0",
  "description": "FoodBridge connects food donors with verified NGOs and delivery partners through a React app and Express API.",
  "private": true,
  "main": "backend/index.js",
  "workspaces": [
    "Admin",
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "npm run start --workspace backend",
    "dev": "node scripts/dev.js",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:admin": "npm run dev --workspace Admin",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend && npm run build --workspace Admin",
    "build:frontend": "npm run build --workspace frontend",
    "build:admin": "npm run build --workspace Admin",
    "create-admin": "npm run create-admin --workspace backend",
    "test": "npm test --workspace backend"
  },
  "engines": {
    "node": ">=20.6"
  }
}
